# Optional override if xhs is not on PATH.
XHS_BIN=xhs

# Optional override if codex is not on PATH.
CODEX_BIN=codex

# MongoDB Atlas connection string. Keep the real value in .env only.
MONGO_URI=

# Optional override for the database specified in MONGO_URI.
MONGO_DB=

# Optional official/public multi-source adapters. Missing credentials cause a
# clean skip; they are not all required.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=local-market-research/0.1

YOUTUBE_API_KEY=

# Optional and disabled by default.
PRODUCT_HUNT_TOKEN=

# Optional structured LLM classification. Rules mode needs no paid API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Shared Apify collection provider. Keep the real token in .env only.
APIFY_API_TOKEN=

# Actor IDs are intentionally configurable and must match the metadata,
# schemas, and templates in config/apify_actors.yaml before a test can run.
APIFY_REDDIT_ACTOR_ID=
APIFY_YOUTUBE_ACTOR_ID=
APIFY_YOUTUBE_COMMENTS_ACTOR_ID=
APIFY_TIKTOK_ACTOR_ID=
APIFY_TIKTOK_COMMENTS_ACTOR_ID=
APIFY_FACEBOOK_ACTOR_ID=
APIFY_APPSTORE_ACTOR_ID=
APIFY_GOOGLEPLAY_ACTOR_ID=
APIFY_TRENDS_ACTOR_ID=

# Conservative cost ceilings in USD. YAML defaults apply when omitted.
APIFY_MAX_ACTOR_RUN_COST_USD=
APIFY_MAX_WORKFLOW_COST_USD=

RESEND_API_KEY=
RESEND_FROM_EMAIL=mail@chaturbo.com
RESEND_ALERT_TO_EMAIL=yoongyy@gmail.com
